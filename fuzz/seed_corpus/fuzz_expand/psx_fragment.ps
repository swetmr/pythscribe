"use client"

from react import use_state

@component
def TodoApp():
    items, set_items = use_state([])
    text, set_text = use_state("")

    return (
        div(class_name="todo-app",
            h1("Todo List"),
            input(value=text, on_change=lambda e: set_text(e.target.value)),
            ul(
                *[li(item) for item in items]
            ),
        ),
        footer(
            p("Made with PythScribe"),
        ),
    )
