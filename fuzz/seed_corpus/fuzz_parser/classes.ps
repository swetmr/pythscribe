class Animal:
    def __init__(self, name, sound):
        self.name = name
        self.sound = sound

    def speak(self):
        return f"{self.name} says {self.sound}"

class Dog(Animal):
    def __init__(self, name):
        self.name = name
        self.sound = "woof"

    def fetch(self, item):
        return f"{self.name} fetches {item}"

dog = Dog("Rex")
print(dog.speak())
print(dog.fetch("ball"))
