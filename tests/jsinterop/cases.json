  {
    "id": "eager_coro",
    "src": [
      "import asyncio",
      "async def w():",
      "    print('started')",
      "    return 1",
      "async def main():",
      "    c = w()",
      "    print('before-await')",
      "    v = await c",
      "    print(v)",
      "asyncio.run(main())"
    ],
    "expected": "started\nbefore-await\n1",
    "note": "DIVERGES from CPython by design: JS async fns run eagerly to the first await at CALL time; CPython coroutines are inert until awaited."
  },
