  {
    "id": "recv_duck_append_remove_classlist",
    "src": [
      "class Node:",
      "    def __init__(self):",
      "        self.kids = []",
      "        self.classList = ClassList()",
      "        self.gone = False",
      "    def append(self, child):",
      "        self.kids.append(child)",
      "    def remove(self):",
      "        self.gone = True",
      "",
      "class ClassList:",
      "    def __init__(self):",
      "        self.names = ['active', 'card']",
      "    def remove(self, name):",
      "        self.names = [n for n in self.names if n != name]",
      "",
      "def demo(el, child):",
      "    el.append(child)",
      "    el.classList.remove('active')",
      "    el.remove()",
      "",
      "n = Node()",
      "demo(n, 'x')",
      "print(n.kids)",
      "print(n.classList.names)",
      "print(n.gone)"
    ],
    "expected": "['x']\n['card']\nTrue",
    "note": "#301: the WB-1 shape with duck receivers — .append/.remove/.classList.remove on objects exposing their own methods dispatch to those methods, exactly as React/DOM receivers do."
  }
]
