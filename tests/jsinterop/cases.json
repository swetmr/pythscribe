[
  {
    "id": "exc_class",
    "src": [
      "import asyncio",
      "async def main():",
      "    try:",
      "        await Promise.reject(Error('boom'))",
      "    except Exception as e:",
      "        print(type(e).__name__)",
      "        print(str(e))",
      "asyncio.run(main())"
    ],
    "expected": "Error\nboom",
    "note": "Awaiting a rejected Promise raises the rejection value; JS Error is caught by `except Exception` / `except Error`, type name 'Error'."
  },
