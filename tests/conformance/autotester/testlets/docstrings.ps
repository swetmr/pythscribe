# Ported from Transcrypt docstrings/__init__.py (Apache-2.0). Edits:
# - stripped Transcrypt import: 'from org.transcrypt.stubs.browser import __pragma__'
# (AutoTester shim is inlined by the runner at execution time.)

'''Just a module
to test docstrings'''
'''Not visible'''

__pragma__ ('docat')

def run (autoTester):
    def f (p):
        '''Just a function
        called f'''
        '''Not visible'''
        autoTester.check (p)

    class C:
        '''Just a class
        called C'''
        '''Not visible'''
        def g (self, q):
            '''Just a method
            called g'''
            '''Not visible'''
            autoTester.check (q)

    autoTester.check (__doc__)
    autoTester.check ()

    autoTester.check (f.__doc__)
    autoTester.check ()

    autoTester.check (C.__doc__)
    autoTester.check ()

    autoTester.check (C.g.__doc__)
    autoTester.check ()

    f ('Doc')
    C () .g ('strings')