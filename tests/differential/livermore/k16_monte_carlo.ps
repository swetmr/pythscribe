# LFK 16 - Monte Carlo search loop (goto-ladder adapted to while+state)
def k16_monte(n: int, loop: int) -> int:
    nd = 300
    zone = [0] * (nd + 4)
    plan = [0.0] * (nd + 4)
    d = [0.0] * (nd + 4)
    i = 0
    while i < nd + 4:
        zone[i] = (i * 7) % 5 - 2
        plan[i] = 0.1 * ((i * 13) % 23 + 1)
        d[i] = 0.05 * ((i * 11) % 19 + 1)
        i = i + 1
    r = 0.36
    sfac = 0.24
    t = 0.48
    m_total = 0
    l = 0
    while l < loop:
        i2 = 1
        k = 0
        count = 0
        while count < n:
            k = k + 1
            dw = -100.0
            j2 = (k + i2) % nd + 1
            m = zone[j2]
            if m < 0:
                dw = dw + plan[j2] * r
            else:
                if m == 0:
                    dw = dw + plan[j2] * sfac
                else:
                    dw = dw + plan[j2] * t
            if dw > d[j2]:
                m_total = m_total + m
            else:
                m_total = m_total - 1
            count = count + 1
        l = l + 1
    return m_total

print(repr(k16_monte(456, 3)))
