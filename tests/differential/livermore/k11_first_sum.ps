# LFK 11 - first sum (prefix sum, loop-carried)
def k11_first_sum(n: int, loop: int) -> float:
    x = [0.0] * n
    y = [0.0] * n
    i = 0
    while i < n:
        y[i] = 0.0001 * (i + 1)
        i = i + 1
    l = 0
    while l < loop:
        x[0] = y[0]
        k = 1
        while k < n:
            x[k] = x[k - 1] + y[k]
            k = k + 1
        l = l + 1
    return x[n - 1]

print(repr(k11_first_sum(1001, 5)))
