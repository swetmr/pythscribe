# LFK 5 — tri-diagonal elimination, below diagonal (loop-carried dependence)
def k05_tridiag(n: int, loop: int) -> float:
    x = [0.0] * n
    y = [0.0] * n
    z = [0.0] * n
    i = 0
    while i < n:
        x[i] = 0.0
        y[i] = 0.0003 * (i + 1)
        z[i] = 0.0007 * (i + 1)
        i = i + 1
    l = 0
    while l < loop:
        x[0] = 0.5
        i = 1
        while i < n:
            x[i] = z[i] * (y[i] - x[i - 1])
            i = i + 1
        l = l + 1
    s = 0.0
    i = 0
    while i < n:
        s = s + x[i]
        i = i + 1
    return s

print(repr(k05_tridiag(1000, 4)))
