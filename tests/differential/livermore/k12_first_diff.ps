# LFK 12 - first difference
def k12_first_diff(n: int, loop: int) -> float:
    x = [0.0] * n
    y = [0.0] * (n + 1)
    i = 0
    while i < n + 1:
        y[i] = 0.0003 * (i + 1) * (i % 7 + 1)
        i = i + 1
    l = 0
    while l < loop:
        k = 0
        while k < n:
            x[k] = y[k + 1] - y[k]
            k = k + 1
        l = l + 1
    s = 0.0
    k = 0
    while k < n:
        s = s + x[k]
        k = k + 1
    return s

print(repr(k12_first_diff(1000, 5)))
