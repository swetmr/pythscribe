# LFK 6 — general linear recurrence equations
def k06_recurrence(n: int, loop: int) -> float:
    w = [0.0] * n
    b = [0.0] * (n * n)
    i = 0
    while i < n:
        w[i] = 0.01 * (i + 1)
        i = i + 1
    i = 0
    while i < n * n:
        b[i] = 0.0001 * (i % 97 + 1)
        i = i + 1
    l = 0
    while l < loop:
        i = 1
        while i < n:
            w[i] = 0.0100
            k = 0
            while k < i:
                w[i] = w[i] + b[k * n + i] * w[(i - k) - 1]
                k = k + 1
            i = i + 1
        l = l + 1
    s = 0.0
    i = 0
    while i < n:
        s = s + w[i]
        i = i + 1
    return s

print(repr(k06_recurrence(60, 2)))
