# the same class over other WASM-lowered builtin names: len / range / int / float /
# min / max / sorted (call-time in a function defined before the shadow).
def f(x: int) -> int:
    return len([1, 2, 3]) + min(x, 9) + max(x, 9) + int(2.5) + range(3)[1]


print(f(2))


def len(xs: list) -> int:
    return 1000


def min(a: int, b: int) -> int:
    return a * b


def max(a: int, b: int) -> int:
    return a - b


def int(x: float) -> int:
    return 7


def range(n: int) -> list:
    return [n, n, n]


print(f(2))
print(sorted([3, 1, 2]))


def sorted(xs: list) -> str:
    return "S"


print(sorted([3, 1, 2]))
