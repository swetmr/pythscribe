# EXPECT: match
# #501 x #500/#491: hoisted local + nonlocal write targets survive the per-alternative bind
def loc(v):
    x = -1
    match v:
        case [x, 1] | [1, x]:
            pass
    return x
print(loc([5, 1]), loc([1, 7]), loc([2, 2]))
def outer():
    x = 1
    def inner(v):
        nonlocal x
        match v:
            case [1, x] | [x, 1]:
                pass
    inner([2, 1]); return x
print(outer())
