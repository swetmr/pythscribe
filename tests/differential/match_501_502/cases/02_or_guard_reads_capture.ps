# EXPECT: match
# #501 + #500: the shared guard reads the capture bound by whichever alternative matched
def g(v):
    match v:
        case [x, 1] | [1, x] if x > 3:
            return ("big", x)
        case [x, 1] | [1, x]:
            return ("small", x)
        case _:
            return "none"
print(g([9, 1]), g([1, 9]), g([2, 1]), g([1, 2]), g([3, 3]))
