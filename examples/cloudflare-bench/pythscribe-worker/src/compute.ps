import math


def fibonacci(n: int) -> int:
    if n < 2:
        return n
    a: int = 0
    b: int = 1
    i: int = 2
    while i <= n:
        c: int = a + b
        a = b
        b = c
        i = i + 1
    return b


def sum_squares(n: int) -> int:
    total: int = 0
    i: int = 1
    while i <= n:
        total = total + i * i
        i = i + 1
    return total


def sin_sum(n: int) -> float:
    total: float = 0.0
    i: int = 1
    while i <= n:
        total = total + math.sin(i)
        i = i + 1
    return total
