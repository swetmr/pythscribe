# Precompiled "use client" islands — regenerated by scripts/precompile-client.mjs
# (predev/prebuild hooks in next/package.json). Never hand-edited.
*.client.js

# Generated TS declaration siblings (vite-plugin-pyths / next-plugin-pyths
# --dts) — regenerated on every compile, anywhere in the tree (shared/ AND
# next/app/**/page.ps). Matches reference-app/frontend + frontend-next's
# .gitignore convention.
*.d.ps.ts
*.d.psc.ts

# PythScribe incremental-compile cache (also covered by the repo-root
# .gitignore; listed here for clarity when this directory is read alone)
.pyths/

# Build output
vite/dist/
next/.next/
next/out/

# node_modules is already covered by the repo-root .gitignore, listed here
# for clarity when this directory is read in isolation.
node_modules/

# tsc incremental / next typegen noise
*.tsbuildinfo
