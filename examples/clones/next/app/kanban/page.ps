from pyths.react import component
from ....shared.kanban.KanbanBoard import KanbanBoard


@component
def KanbanPage():
    return main(
        style={"padding": "20px"},
        p(a(href="/", "← home")),
        KanbanBoard(),
    )


__default__ = KanbanPage
