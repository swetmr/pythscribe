@wasm
def dtw_distance(a: list[float], b: list[float], prev: list[float], cur: list[float]) -> float:
    n = len(a)
    m = len(b)
    big = 1e300
    for j in range(m + 1):
        prev[j] = big
    prev[0] = 0.0
    for i in range(1, n + 1):
        cur[0] = big
        for j in range(1, m + 1):
            d = a[i - 1] - b[j - 1]
            if d < 0.0:
                d = -d
            best = prev[j]
            if cur[j - 1] < best:
                best = cur[j - 1]
            if prev[j - 1] < best:
                best = prev[j - 1]
            cur[j] = d + best
        for j in range(m + 1):
            prev[j] = cur[j]
    return prev[m]
