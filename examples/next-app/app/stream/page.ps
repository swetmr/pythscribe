"""Suspense streaming: the shell + fallback flush immediately; the slow
async child streams as a later, out-of-order chunk once its await resolves."""
from pyths.react import component, Suspense

# Force dynamic rendering so streaming happens per-request (not prerender).
dynamic = "force-dynamic"


async def slow_posts():
    res = await fetch("https://jsonplaceholder.typicode.com/posts?_limit=3")
    return await res.json()


@component
async def SlowList():
    posts = await slow_posts()
    return ul()(*[li(key=str(p["id"]))(p["title"]) for p in posts])


@component
def StreamPage():
    return main(style={"padding": "20px"})(
        h1()("Streaming shell"),
        p()("This shell text flushes immediately."),
        Suspense(fallback=p()("Loading posts…"))(SlowList()),
    )


__default__ = StreamPage
