# Pre-compiled PythScribe client components (generated by precompile-client).
# The `.client.js` suffix is required — the loader's importer-aware rewrite
# resolves `./Counter` to `Counter.client.js` ahead of `Counter.psc`, keeping
# the "use client" island off the Turbopack loader path (see README).
app/counter/Counter.client.js
# vite/next emitDts artifacts (disabled here, belt-and-suspenders)
app/**/*.d.ps.ts
app/**/*.d.psc.ts

# Next.js generated
next-env.d.ts
