{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PythScribe",
  "scopeName": "source.pyths",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#types" },
    { "include": "#psx-tags" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.pyths",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.double.pyths",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.triple.single.pyths",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.interpolated.pyths",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.pyths",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.pyths" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.pyths" } },
              "patterns": [
                { "include": "$self" }
              ]
            },
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.interpolated.pyths",
          "begin": "f'",
          "end": "'",
          "patterns": [
            {
              "name": "meta.interpolation.pyths",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": { "0": { "name": "punctuation.definition.interpolation.begin.pyths" } },
              "endCaptures": { "0": { "name": "punctuation.definition.interpolation.end.pyths" } },
              "patterns": [
                { "include": "$self" }
              ]
            },
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.double.pyths",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.single.pyths",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.pyths",
          "match": "\\\\[\\\\\"'nrtbf0]"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.pyths",
          "match": "^\\s*(@\\w+(?:\\.\\w+)*)(\\(.*\\))?",
          "captures": {
            "1": { "name": "entity.name.function.decorator.pyths" },
            "2": { "name": "meta.decorator.arguments.pyths" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.pyths",
          "match": "\\b(if|elif|else|for|while|break|continue|return|yield|pass|raise|try|except|finally|with|match|case|async|await)\\b"
        },
        {
          "name": "keyword.other.pyths",
          "match": "\\b(import|from|as|in|not|and|or|is|del|assert|global|nonlocal|lambda)\\b"
        },
        {
          "name": "storage.type.function.pyths",
          "match": "\\b(def)\\b"
        },
        {
          "name": "storage.type.class.pyths",
          "match": "\\b(class)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.pyths",
          "match": "\\b(print|len|range|enumerate|zip|sorted|reversed|isinstance|type|str|int|float|bool|list|dict|set|tuple|abs|min|max|sum|round|map|filter|any|all|input|repr|super|next|iter|hasattr|getattr|setattr|delattr|callable|open|id|hash|hex|oct|bin|ord|chr)\\b"
        },
        {
          "name": "support.function.pyths",
          "match": "\\b(use_state|use_effect|use_context|use_ref|use_memo|use_callback|use_reducer|use_layout_effect|use_id|use_transition|use_deferred_value)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.pyths",
          "match": "\\b(True|False|None)\\b"
        },
        {
          "name": "variable.language.self.pyths",
          "match": "\\b(self|cls)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pyths",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.pyths",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.pyths",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.pyths",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d[\\d_]*)?\\b|\\b\\d[\\d_]*[eE][+-]?\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.pyths",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.pyths",
          "match": "(\\+=|-=|\\*=|/=|//=|%=|\\*\\*=|&=|\\|=|\\^=|<<=|>>=|:=|=)"
        },
        {
          "name": "keyword.operator.comparison.pyths",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.pyths",
          "match": "(\\*\\*|//|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.pyths",
          "match": "(<<|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.arrow.pyths",
          "match": "->"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.pyths",
          "match": "\\b(def)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.function.pyths" },
            "2": { "name": "entity.name.function.pyths" }
          }
        },
        {
          "name": "meta.function-call.pyths",
          "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.pyths" }
          }
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "meta.class.pyths",
          "match": "\\b(class)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.class.pyths" },
            "2": { "name": "entity.name.type.class.pyths" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.pyths",
          "match": "\\b(int|float|str|bool|list|dict|set|tuple|Optional|List|Dict|Set|Tuple|Union|Any|Callable|None)\\b"
        }
      ]
    },
    "psx-tags": {
      "patterns": [
        {
          "name": "meta.tag.pyths",
          "match": "</?([a-z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "entity.name.tag.html.pyths" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.pyths",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    }
  }
}
